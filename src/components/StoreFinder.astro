---
import Icon from './Icon.astro';
import TornEdge from './TornEdge.astro';
import { cities, routeHref, stores, storesIntro as t } from '../data/stores';

const countFor = (city: string) => stores.filter((s) => s.city === city).length;
---

<section id="filialfinder" class="cv-auto on-light relative bg-paper pt-16 pb-28 text-text-dark lg:pt-20 lg:pb-36" data-store-finder>
  <div class="container-page">
    <!-- Suche + Stadtfilter -->
    <div class="card-light p-5 sm:p-6" data-reveal>
      <label class="relative block">
        <span class="sr-only">{t.searchPlaceholder}</span>
        <Icon name="search" size={20} class="pointer-events-none absolute top-1/2 left-4 -translate-y-1/2 text-muted-dark" />
        <input type="search" class="field !pl-12" placeholder={t.searchPlaceholder} autocomplete="off" data-store-search />
      </label>
      <div class="mt-4 flex items-center gap-3">
        <span class="shrink-0 text-xs font-bold tracking-[0.08em] uppercase">{t.cityLabel}</span>
        <div class="snap-track -mr-5 gap-2 pr-5 sm:mr-0 sm:flex-wrap sm:pr-0" role="group" aria-label={t.cityLabel}>
          <button type="button" class="chip" aria-pressed="true" data-city-filter="">
            {t.allLabel} ({stores.length})
          </button>
          {
            cities.map((city) => (
              <button type="button" class="chip" aria-pressed="false" data-city-filter={city}>
                {city} ({countFor(city)})
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-2 text-sm">
      <p aria-live="polite"><strong data-store-count>{stores.length}</strong> {t.foundSuffix}</p>
      <p class="inline-flex items-center gap-2 font-semibold text-muted-dark">
        <Icon name="shield" size={18} class="text-accent-deep" />
        {t.halalNote}
      </p>
    </div>

    <div class="mt-6 grid gap-8 lg:grid-cols-[1fr_1.05fr]">
      <!-- Liste -->
      <div>
        <ul class="grid gap-5 md:grid-cols-2 lg:grid-cols-1" data-store-list>
          {
            stores.map((s) => (
              <li
                class="card-light flex flex-col p-5 transition-[border-color] data-[selected=true]:border-accent"
                data-store
                data-city={s.city}
                data-search={`${s.name} ${s.address} ${s.city}`.toLowerCase()}
              >
                <article class="flex h-full flex-col">
                  <div class="flex items-center gap-2">
                    <span class="text-xs font-bold tracking-[0.08em] text-muted-dark uppercase">{s.city}</span>
                    {s.isNew && <span class="badge !px-2 !py-0.5 !text-[0.625rem]">{t.newBadge}</span>}
                  </div>
                  <h2 class="mt-2 text-[0.95rem] leading-snug font-extrabold">{s.name}</h2>
                  <ul class="mt-3 space-y-1.5 text-sm text-muted-dark">
                    <li class="flex gap-2">
                      <Icon name="pin" size={18} class="mt-0.5 shrink-0 text-accent-deep" />
                      {s.address}
                    </li>
                    <li class="flex gap-2">
                      <Icon name="clock" size={18} class="mt-0.5 shrink-0 text-accent-deep" />
                      {s.hours}
                    </li>
                    <li class="flex gap-2">
                      <Icon name="phone" size={18} class="mt-0.5 shrink-0 text-accent-deep" />
                      <a href={s.phoneHref} class="underline decoration-accent decoration-2 underline-offset-4 hover:text-text-dark">
                        {s.phone}
                      </a>
                    </li>
                  </ul>
                  <ul class="mt-4 flex flex-wrap gap-1.5">
                    {s.features.map((f) => (
                      <li class="rounded-sm bg-paper px-2 py-1 text-[0.7rem] font-semibold text-muted-dark">{f}</li>
                    ))}
                  </ul>
                  <div class="mt-auto flex flex-wrap items-center gap-2 pt-5">
                    <button type="button" class="btn btn-primary flex-1 !px-3" data-map-address={s.address} data-map-name={s.name}>
                      <Icon name="map" size={16} />
                      {t.showOnMap}
                    </button>
                    <a
                      href={routeHref(s.address)}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${t.route}: ${s.name}`}
                      class="grid size-11 place-items-center rounded-[2px] border border-line text-text-dark transition-colors hover:border-text-dark"
                    >
                      <Icon name="route" size={18} />
                    </a>
                    <a
                      href={s.orderHref}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn border border-text-dark !px-4 text-text-dark hover:bg-text-dark hover:text-white"
                    >
                      <Icon name="bag" size={16} />
                      {t.order}
                    </a>
                  </div>
                </article>
              </li>
            ))
          }
        </ul>
        <div class="card-light hidden p-8 text-center" data-store-empty>
          <p class="font-extrabold">{t.emptyTitle}</p>
          <p class="mt-2 text-sm text-muted-dark">{t.emptyText}</p>
        </div>
      </div>

      <!-- Karte: externes Google-Maps-iframe erst nach Klick -->
      <div class="lg:sticky lg:top-24 lg:self-start">
        <div class="on-dark relative flex min-h-[26rem] flex-col items-center justify-center overflow-hidden rounded-[4px] bg-ink p-8 text-center text-white lg:min-h-[36rem]" data-map-panel>
          <div class="texture-chalk absolute inset-0" aria-hidden="true"></div>
          <div class="relative" data-map-placeholder>
            <Icon name="map" size={52} class="mx-auto text-accent" />
            <h2 class="mt-5 text-lg font-extrabold tracking-[0.06em]">{t.mapHeading}</h2>
            <p class="mx-auto mt-3 max-w-sm text-sm text-white/70">{t.mapText}</p>
            <button type="button" class="btn btn-primary mt-6" data-map-load>
              <Icon name="chevron-right" size={16} class="stroke-[2.5]" />
              {t.mapButton}
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <TornEdge color="text-night" seed={63} />
</section>

<script>
  function initStoreFinder() {
    const root = document.querySelector<HTMLElement>('[data-store-finder]');
    if (!root) return;

    const search = root.querySelector<HTMLInputElement>('[data-store-search]');
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-city-filter]')];
    const cards = [...root.querySelectorAll<HTMLElement>('[data-store]')];
    const count = root.querySelector<HTMLElement>('[data-store-count]');
    const empty = root.querySelector<HTMLElement>('[data-store-empty]');
    const panel = root.querySelector<HTMLElement>('[data-map-panel]');
    let city = '';

    const apply = () => {
      const q = (search?.value ?? '').trim().toLowerCase();
      let visible = 0;
      for (const card of cards) {
        const show = (!city || card.dataset.city === city) && (!q || (card.dataset.search ?? '').includes(q));
        card.hidden = !show;
        if (show) visible++;
      }
      if (count) count.textContent = String(visible);
      empty?.classList.toggle('hidden', visible > 0);
    };

    search?.addEventListener('input', apply);
    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        city = chip.dataset.cityFilter ?? '';
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        apply();
      }),
    );

    // Karte erst auf Nutzeraktion laden (keine externen Requests beim Seitenaufruf)
    const showMap = (address: string, name: string) => {
      if (!panel) return;
      panel.innerHTML = '';
      const iframe = document.createElement('iframe');
      iframe.src = `https://maps.google.com/maps?q=${encodeURIComponent(address)}&z=15&output=embed`;
      iframe.title = name;
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      iframe.className = 'absolute inset-0 size-full border-0';
      panel.append(iframe);
    };

    root.querySelectorAll<HTMLButtonElement>('[data-map-address]').forEach((btn) =>
      btn.addEventListener('click', () => {
        cards.forEach((c) => c.setAttribute('data-selected', String(c.contains(btn))));
        showMap(btn.dataset.mapAddress ?? '', btn.dataset.mapName ?? '');
        if (window.matchMedia('(max-width: 1023px)').matches) panel?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }),
    );
    root.querySelector('[data-map-load]')?.addEventListener('click', () => {
      const first = cards.find((c) => !c.hidden)?.querySelector<HTMLButtonElement>('[data-map-address]');
      first?.click();
    });
  }

  initStoreFinder();
</script>
