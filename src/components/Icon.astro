---
// Line-Icons (Stroke 1.5) im Stil der Vorlage + Social-Glyphen
export type IconName =
  | 'chevron-right'
  | 'chevron-left'
  | 'chevron-down'
  | 'chevron-up'
  | 'pin'
  | 'clock'
  | 'phone'
  | 'mail'
  | 'route'
  | 'bag'
  | 'map'
  | 'search'
  | 'close'
  | 'user'
  | 'chat'
  | 'star'
  | 'shield'
  | 'leaf'
  | 'spark'
  | 'handshake'
  | 'chart'
  | 'store'
  | 'arrow-right'
  | 'facebook'
  | 'youtube'
  | 'instagram'
  | 'x'
  | 'linkedin';

interface Props {
  name: IconName;
  class?: string;
  size?: number;
}

const { name, class: className, size = 20 } = Astro.props;
const filled = ['facebook', 'youtube', 'x', 'linkedin', 'star'].includes(name);
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'chevron-right' && <path d="m9 5 7 7-7 7" />}
  {name === 'chevron-left' && <path d="m15 5-7 7 7 7" />}
  {name === 'chevron-down' && <path d="m5 9 7 7 7-7" />}
  {name === 'chevron-up' && <path d="m5 15 7-7 7 7" />}
  {name === 'arrow-right' && <path d="M4 12h16m-6-6 6 6-6 6" />}
  {
    name === 'pin' && (
      <>
        <path d="M12 21s-7-6.1-7-11.5A7 7 0 0 1 19 9.5C19 14.9 12 21 12 21Z" />
        <circle cx="12" cy="9.5" r="2.5" />
      </>
    )
  }
  {
    name === 'clock' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M12 7v5l3 2" />
      </>
    )
  }
  {name === 'phone' && <path d="M5 4h3l2 5-2.5 1.5a11 11 0 0 0 6 6L15 14l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" />}
  {
    name === 'mail' && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m3 7 9 6 9-6" />
      </>
    )
  }
  {
    name === 'route' && (
      <>
        <circle cx="6" cy="19" r="2" />
        <circle cx="18" cy="5" r="2" />
        <path d="M8 19h8.5a3.5 3.5 0 0 0 0-7h-9a3.5 3.5 0 0 1 0-7H16" />
      </>
    )
  }
  {
    name === 'bag' && (
      <>
        <path d="M5 8h14l-1 12H6L5 8Z" />
        <path d="M9 8V6a3 3 0 0 1 6 0v2" />
      </>
    )
  }
  {
    name === 'map' && (
      <>
        <path d="m3 6 6-2 6 2 6-2v14l-6 2-6-2-6 2V6Z" />
        <path d="M9 4v14m6-12v14" />
      </>
    )
  }
  {
    name === 'search' && (
      <>
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-3.5-3.5" />
      </>
    )
  }
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
  {
    name === 'user' && (
      <>
        <circle cx="12" cy="8" r="4" />
        <path d="M4 21a8 8 0 0 1 16 0" />
      </>
    )
  }
  {name === 'chat' && <path d="M21 12c0 4.4-4 8-9 8a9.9 9.9 0 0 1-4.3-.9L3 20l1.4-3.7A7.4 7.4 0 0 1 3 12c0-4.4 4-8 9-8s9 3.6 9 8Z" />}
  {name === 'star' && <path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3Z" />}
  {
    name === 'shield' && (
      <>
        <path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.3 7.5 9.5 4.3-1.2 7.5-4.9 7.5-9.5V6L12 3Z" />
        <path d="m8.5 12 2.5 2.5 4.5-5" />
      </>
    )
  }
  {
    name === 'leaf' && (
      <>
        <path d="M5 19c0-8 5-13 15-14-1 10-6 15-14 15" />
        <path d="M5 19 13 11" />
      </>
    )
  }
  {
    name === 'spark' && (
      <>
        <path d="M12 3v4m0 10v4M3 12h4m10 0h4" />
        <path d="m12 8 1.5 2.5L16 12l-2.5 1.5L12 16l-1.5-2.5L8 12l2.5-1.5L12 8Z" />
      </>
    )
  }
  {
    name === 'handshake' && (
      <>
        <path d="m2 11 4-4 4 2 3-2 5 1 4 4" />
        <path d="m6 13 4 4a1.5 1.5 0 0 0 2-2m0 0 1 1a1.5 1.5 0 0 0 2-2m0 0 .5.5a1.5 1.5 0 0 0 2-2L13 9" />
        <path d="M2 11l3 3m17-3-3 3" />
      </>
    )
  }
  {
    name === 'chart' && (
      <>
        <path d="M4 20V4m0 16h16" />
        <path d="m7 15 4-4 3 3 5-6" />
      </>
    )
  }
  {
    name === 'store' && (
      <>
        <path d="M4 10v10h16V10" />
        <path d="M3 10 5 4h14l2 6a3 3 0 0 1-6 0 3 3 0 0 1-6 0 3 3 0 0 1-6 0Z" />
        <path d="M10 20v-5h4v5" />
      </>
    )
  }
  {name === 'facebook' && <path d="M13.5 21v-7.5H16l.5-3h-3V8.6c0-.9.3-1.6 1.6-1.6h1.6V4.3A21 21 0 0 0 14.4 4c-2.3 0-3.9 1.4-3.9 4v2.5H8v3h2.5V21h3Z" />}
  {name === 'youtube' && <path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8ZM10 15V9l5.2 3L10 15Z" />}
  {
    name === 'instagram' && (
      <>
        <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" />
      </>
    )
  }
  {name === 'x' && <path d="M17.8 3h3.1l-6.8 7.8L22 21h-6.2l-4.9-6.4L5.3 21H2.2l7.3-8.3L2 3h6.4l4.4 5.8L17.8 3Zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5Z" />}
  {name === 'linkedin' && <path d="M6.9 21H3.3V9h3.6v12ZM5.1 7.4a2.1 2.1 0 1 1 0-4.2 2.1 2.1 0 0 1 0 4.2ZM21 21h-3.6v-5.8c0-1.4 0-3.2-2-3.2s-2.2 1.5-2.2 3.1V21H9.6V9h3.4v1.6h.1a3.8 3.8 0 0 1 3.4-1.9c3.6 0 4.3 2.4 4.3 5.5V21Z" />}
</svg>
