---
import Icon from './Icon.astro';
import TornEdge from './TornEdge.astro';
import { press } from '../data/news';
---

<section id="presse" class="cv-auto on-light relative bg-paper py-24 text-text-dark lg:py-28">
  <div class="container-page">
    <div class="card-light mx-auto flex max-w-4xl flex-col items-start gap-6 p-8 md:flex-row md:items-center md:justify-between md:p-10" data-reveal>
      <div>
        <p class="eyebrow text-muted-dark">{press.eyebrow}</p>
        <h2 class="mt-2 text-xl font-extrabold">{press.heading}</h2>
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-muted-dark">{press.text}</p>
      </div>
      <a href={press.cta.href} class="btn btn-primary shrink-0">
        <Icon name="chevron-right" size={16} class="stroke-[2.5]" />
        {press.cta.label}
      </a>
    </div>
  </div>

  <TornEdge color="text-night" seed={77} />
</section>
