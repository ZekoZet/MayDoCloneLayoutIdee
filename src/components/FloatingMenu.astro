---
// Floating Menu Button – nur Handy & Tablet (Variante "touch").
// Schwebender Knopf unten rechts; beim Öffnen wächst ein Kreis aus dem Knopf
// über den ganzen Bildschirm, die Menüpunkte schweben gestaffelt herein und
// der Burger wird zum X. Animationen ausschließlich über transform/opacity.
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-512.png';
import Icon from './Icon.astro';
import { nav, site, social } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string, children?: { href: string }[]) =>
  href === '/' ? path === '/' : path.startsWith(href) || !!children?.some((c) => path.startsWith(c.href));
---

<button type="button" class="fab hidden touch:grid" aria-label="Menü öffnen" aria-controls="fab-menu" aria-expanded="false" data-fab-open>
  <span class="fab-lines" aria-hidden="true"><span></span><span></span><span></span></span>
</button>

<dialog id="fab-menu" class="fab-menu" aria-label="Menü">
  <div class="fab-menu-bg" aria-hidden="true"></div>

  <div class="fab-menu-content">
    <a href="/" aria-label={site.homeAria} class="fab-item inline-flex self-start" style="--i: 0">
      <Image src={logo} alt={site.logoAlt} widths={[48, 96, 144]} sizes="48px" class="size-12" />
    </a>

    <nav aria-label="Mobile Navigation" class="fab-nav">
      <ul class="fab-list">
        {
          nav.map((item, i) => (
            <li class="fab-item" style={`--i: ${i + 1}`}>
              <a
                href={item.href}
                class:list={['fab-link', isActive(item.href, item.children) && 'is-current']}
                aria-current={path === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
              {item.children && (
                <ul class="mt-1 flex flex-wrap gap-x-5">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class="inline-flex min-h-11 items-center gap-1.5 text-[0.95rem] text-white/70 transition-colors hover:text-accent"
                        aria-current={path === child.href ? 'page' : undefined}
                      >
                        <Icon name="chevron-right" size={13} class="text-accent" />
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="fab-item fab-footer" style={`--i: ${nav.length + 1}`}>
      <a href={site.cta.href} class="btn btn-primary">
        <Icon name="pin" size={16} />
        {site.cta.label}
      </a>
      <ul class="flex flex-wrap gap-2">
        {
          social.map((s) => (
            <li>
              <a
                href={s.href}
                aria-label={s.label}
                target="_blank"
                rel="noopener noreferrer"
                class="grid size-11 place-items-center rounded-full border border-white/25 text-white/75 transition-colors hover:border-accent hover:text-accent"
              >
                <Icon name={s.key} size={16} />
              </a>
            </li>
          ))
        }
      </ul>
      <p class="w-full text-xs text-white/55">{site.copyrightShort}</p>
    </div>
  </div>

  <!-- Gleicher Knopf an gleicher Stelle, verwandelt sich in ein X -->
  <button type="button" class="fab grid" aria-label="Menü schließen" data-fab-close>
    <span class="fab-lines" aria-hidden="true"><span></span><span></span><span></span></span>
  </button>
</dialog>

<style>
  /* ---------- Schwebender Knopf ---------- */
  .fab {
    --fab-size: 3.5rem;
    position: fixed;
    z-index: 55;
    right: calc(1rem + env(safe-area-inset-right));
    bottom: calc(1rem + env(safe-area-inset-bottom));
    width: var(--fab-size);
    height: var(--fab-size);
    place-items: center;
    border-radius: 9999px;
    background: var(--color-accent);
    color: var(--color-text-dark);
    box-shadow:
      0 12px 28px -10px rgb(0 0 0 / 0.65),
      0 0 0 0 rgb(250 192 20 / 0.45);
    transition: transform 0.25s var(--ease-out-soft);
    -webkit-tap-highlight-color: transparent;
  }
  .fab:active {
    transform: scale(0.92);
  }
  .fab:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  /* Burger aus drei unterschiedlich langen Linien (Vorlage) → X */
  .fab-lines {
    position: relative;
    display: block;
    width: 22px;
    height: 16px;
  }
  .fab-lines span {
    position: absolute;
    right: 0;
    width: 22px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transform-origin: right center;
    transition:
      transform 0.45s var(--ease-out-soft),
      opacity 0.2s ease;
  }
  .fab-lines span:nth-child(1) {
    top: 0;
  }
  .fab-lines span:nth-child(2) {
    top: 7px;
    transform: scaleX(0.64);
  }
  .fab-lines span:nth-child(3) {
    top: 14px;
    transform: scaleX(0.82);
  }
  .fab-menu[data-state='open'] .fab-lines span {
    transform-origin: center;
  }
  .fab-menu[data-state='open'] .fab-lines span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .fab-menu[data-state='open'] .fab-lines span:nth-child(2) {
    transform: scaleX(0);
    opacity: 0;
  }
  .fab-menu[data-state='open'] .fab-lines span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ---------- Overlay ---------- */
  .fab-menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: #fff;
    overflow: hidden;
  }
  .fab-menu::backdrop {
    background: transparent;
  }

  /* Kreis wächst aus dem Knopf (Mittelpunkt = Knopfmitte) */
  .fab-menu-bg {
    --d: 300vmax;
    position: fixed;
    width: var(--d);
    height: var(--d);
    right: calc(1rem + env(safe-area-inset-right) + 1.75rem - var(--d) / 2);
    bottom: calc(1rem + env(safe-area-inset-bottom) + 1.75rem - var(--d) / 2);
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 50%, rgb(250 192 20 / 0.12), transparent 9%),
      var(--color-ink);
    transform: scale(0);
    transition: transform 0.65s cubic-bezier(0.7, 0, 0.2, 1);
  }
  .fab-menu[data-state='open'] .fab-menu-bg {
    transform: scale(1);
  }
  .fab-menu[data-state='closing'] .fab-menu-bg {
    transition-duration: 0.5s;
    transition-delay: 0.08s;
  }

  .fab-menu-content {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: calc(1rem + env(safe-area-inset-top)) calc(1.5rem + env(safe-area-inset-right))
      calc(6rem + env(safe-area-inset-bottom)) calc(1.5rem + env(safe-area-inset-left));
  }
  .fab-nav {
    margin-block: auto;
  }
  .fab-list {
    display: grid;
    gap: 0.75rem;
  }
  .fab-link {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    font-size: clamp(1.6rem, 1.1rem + 2.6vw, 2.6rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: 0.03em;
    transition: color 0.2s ease;
  }
  .fab-link:hover,
  .fab-link.is-current {
    color: var(--color-accent);
  }
  .fab-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  /* Menüpunkte schweben gestaffelt herein */
  .fab-item {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.35s ease,
      transform 0.55s var(--ease-out-soft);
    transition-delay: calc(var(--i) * 60ms + 220ms);
  }
  .fab-menu[data-state='open'] .fab-item {
    opacity: 1;
    transform: none;
  }
  .fab-menu[data-state='closing'] .fab-item {
    transition-duration: 0.18s;
    transition-delay: 0ms;
  }

  /* Tablet hoch: großzügiger, linksbündig mit Luft */
  @media (min-width: 48rem) {
    .fab-menu-content {
      padding-inline: calc(3rem + env(safe-area-inset-left)) calc(3rem + env(safe-area-inset-right));
    }
    .fab-list {
      gap: 1.1rem;
    }
  }
  /* Quer (Handy): wenig Höhe → zweispaltig, kompakter */
  @media (orientation: landscape) and (max-height: 32rem) {
    .fab-menu-content {
      gap: 0.75rem;
      padding-top: calc(0.75rem + env(safe-area-inset-top));
      padding-bottom: calc(1rem + env(safe-area-inset-bottom));
    }
    .fab-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.25rem 2rem;
    }
    .fab-link {
      min-height: 2.75rem;
      font-size: 1.35rem;
    }
    .fab-footer {
      padding-right: 5rem; /* Platz für den Knopf unten rechts */
    }
  }
</style>

<script>
  function initFloatingMenu() {
    const dialog = document.getElementById('fab-menu') as HTMLDialogElement | null;
    const openBtn = document.querySelector<HTMLButtonElement>('[data-fab-open]');
    const closeBtn = document.querySelector<HTMLButtonElement>('[data-fab-close]');
    if (!dialog || !openBtn || !closeBtn) return;

    const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let closeTimer = 0;

    const open = () => {
      window.clearTimeout(closeTimer);
      dialog.showModal();
      // Fokus gezielt auf den ersten Menüpunkt (sonst greift im Querformat der Scroll-Container)
      dialog.querySelector<HTMLElement>('.fab-link')?.focus({ preventScroll: true });
      document.documentElement.style.overflow = 'hidden';
      openBtn.setAttribute('aria-expanded', 'true');
      // zwei Frames warten, damit die Startwerte gerendert sind und die Transition läuft
      requestAnimationFrame(() => requestAnimationFrame(() => dialog.setAttribute('data-state', 'open')));
    };

    const finishClose = () => {
      dialog.close();
      dialog.removeAttribute('data-state');
      document.documentElement.style.overflow = '';
      openBtn.setAttribute('aria-expanded', 'false');
    };

    const close = (restoreFocus = true) => {
      if (!dialog.open || dialog.getAttribute('data-state') === 'closing') return;
      dialog.setAttribute('data-state', 'closing');
      closeTimer = window.setTimeout(
        () => {
          finishClose();
          if (restoreFocus) openBtn.focus();
        },
        reduced() ? 0 : 600,
      );
    };

    openBtn.addEventListener('click', open);
    closeBtn.addEventListener('click', () => close());
    // Escape: eigene Schließ-Animation statt sofortigem Schließen
    dialog.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });
    // Links im Menü: Overlay schließen, Navigation läuft normal weiter
    dialog.querySelectorAll('a[href^="/"]').forEach((a) => a.addEventListener('click', () => close(false)));
    // Wechsel auf Desktop-Größe (z. B. Fenster vergrößert): Menü sofort zu
    const desk = window.matchMedia('(min-width: 64rem) and (hover: hover)');
    const onDesk = () => desk.matches && dialog.open && finishClose();
    desk.addEventListener('change', onDesk);

    // Zurück-Navigation aus dem Browser-Cache (bfcache): Menü geschlossen anzeigen
    window.addEventListener('pageshow', (e) => {
      if (e.persisted && dialog.open) {
        window.clearTimeout(closeTimer);
        finishClose();
      }
    });
  }

  initFloatingMenu();
</script>
