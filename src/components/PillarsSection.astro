---
import Icon from './Icon.astro';
import ScriptHeading from './ScriptHeading.astro';
import TornEdge from './TornEdge.astro';
import { pillars, pillarsIntro } from '../data/pillars';
---

<section id="saeulen" class="cv-auto on-light relative bg-paper pt-24 pb-28 text-text-dark lg:pt-28 lg:pb-36">
  <div class="container-page">
    <ScriptHeading large="Unsere" small="Säulen" tone="accent" smallAfter>
      <h2 class="headline mx-auto mt-7 max-w-2xl text-text-dark" data-reveal>{pillarsIntro.heading}</h2>
      <p class="mx-auto mt-4 max-w-xl text-muted-dark" data-reveal>{pillarsIntro.text}</p>
    </ScriptHeading>

    <ul class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
      {
        pillars.map((p) => (
          <li class="card-light flex flex-col p-7">
            <div class="flex items-start justify-between gap-4">
              <Icon name={p.icon} size={40} class="text-accent-deep" />
              <span class="font-script text-5xl leading-none text-accent-ink" aria-hidden="true">
                {p.number}
              </span>
            </div>
            <p class="eyebrow mt-5 !text-[0.68rem] text-muted-dark">{p.category}</p>
            <h3 class="mt-2 text-[0.95rem] leading-snug font-extrabold">{p.title}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-muted-dark">{p.text}</p>
            <div class="mt-6 flex items-center justify-between border-t border-line pt-4">
              <span class="text-xs font-semibold text-muted-dark">{pillarsIntro.standardLabel}</span>
              <span class="badge">{p.standard}</span>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <TornEdge color="text-night" seed={57} />
</section>
